{
  "name": "alex-oliynyk-personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oleksandr (Alex) Oliynyk's personal portfolio website",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "tsc -b && vite build",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh",
    "deploy:list": "wrangler pages deployment list --project-name my-website",
    "develop": "vite",
    "start": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@react-spring/parallax": "9.7.5",
    "@react-spring/web": "9.7.5",
    "@theme-ui/css": "0.17.4",
    "@theme-ui/preset-tailwind": "0.17.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-image-gallery": "2.1.2",
    "react-typist-component": "1.1.1",
    "theme-ui": "0.17.4"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "resolutions": {
    "yaml": "1.10.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
